{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["serviceImage", "workerImage", "postgres", "ingress", "storage", "egress", "workerQuota", "secrets", "roomRunner"],
  "$defs": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
      }
    },
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "quantity": {"type": "string", "minLength": 1}
  },
  "properties": {
    "serviceImage": {"$ref": "#/$defs/image"},
    "workerImage": {"$ref": "#/$defs/image"},
    "postgres": {
      "type": "object", "additionalProperties": false,
      "required": ["bundled", "image", "databaseSecretName", "storageClass", "size"],
      "properties": {
        "bundled": {"type": "boolean"}, "image": {"type": "string", "minLength": 1},
        "databaseSecretName": {"$ref": "#/$defs/name"}, "storageClass": {"type": "string"}, "size": {"$ref": "#/$defs/quantity"}
      }
    },
    "ingress": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "className", "host", "tlsSecretName"],
      "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "host": {"type": "string", "minLength": 1}, "tlsSecretName": {"type": "string"}}
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["storageClass", "artifactsSize", "referenceCacheSize", "buildkitCacheSize"],
      "properties": {"storageClass": {"type": "string"}, "artifactsSize": {"$ref": "#/$defs/quantity"}, "referenceCacheSize": {"$ref": "#/$defs/quantity"}, "buildkitCacheSize": {"$ref": "#/$defs/quantity"}}
    },
    "egress": {"type": "object", "additionalProperties": false, "required": ["allowlist"], "properties": {"allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "workerQuota": {
      "type": "object", "additionalProperties": false,
      "required": ["jobs", "persistentVolumeClaims", "requestsCpu", "requestsMemory", "limitsCpu", "limitsMemory"],
      "properties": {"jobs": {"$ref": "#/$defs/quantity"}, "persistentVolumeClaims": {"$ref": "#/$defs/quantity"}, "requestsCpu": {"$ref": "#/$defs/quantity"}, "requestsMemory": {"$ref": "#/$defs/quantity"}, "limitsCpu": {"$ref": "#/$defs/quantity"}, "limitsMemory": {"$ref": "#/$defs/quantity"}}
    },
    "secrets": {
      "type": "object", "additionalProperties": false,
      "required": ["githubApp", "githubAppPrivateKey", "githubAppWebhook", "firstRunToken"],
      "properties": {"githubApp": {"$ref": "#/$defs/name"}, "githubAppPrivateKey": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/name"}]}, "githubAppWebhook": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/name"}]}, "firstRunToken": {"$ref": "#/$defs/name"}}
    },
    "roomRunner": {
      "type": "object", "additionalProperties": false,
      "required": ["apiUrl", "provider", "image", "idleTimeoutMinutes", "maxRunnerSeconds", "defaultHarness", "defaultModel", "models", "workspaceSize", "maxConcurrency", "launchTimeoutSeconds", "prepareTimeoutSeconds", "collectorTimeoutSeconds", "verifierTimeoutSeconds"],
      "properties": {"apiUrl": {"type": "string"}, "provider": {"enum": ["kubernetes", "docker"]}, "image": {"type": "string"}, "idleTimeoutMinutes": {"type": "integer", "minimum": 1}, "maxRunnerSeconds": {"type": "integer", "minimum": 600}, "defaultHarness": {"type": "string", "minLength": 1}, "defaultModel": {"type": "string", "minLength": 1}, "models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "workspaceSize": {"$ref": "#/$defs/quantity"}, "maxConcurrency": {"type": "integer", "minimum": 1}, "launchTimeoutSeconds": {"type": "integer", "minimum": 1}, "prepareTimeoutSeconds": {"type": "integer", "minimum": 1}, "collectorTimeoutSeconds": {"type": "integer", "minimum": 1}, "verifierTimeoutSeconds": {"type": "integer", "minimum": 1}}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["nameOverride", "namespaceOverride", "workersNamespaceOverride", "serviceImage", "workerImage", "postgres", "ingress", "storage", "buildkit", "cluster", "egress", "workerQuota", "secrets", "provider", "roomRunner", "extraSettings"],
  "if": {"properties": {"workersNamespaceOverride": {"const": ""}}},
  "then": {"properties": {"namespaceOverride": {"maxLength": 55}}},
  "$defs": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
      },
      "if": {"properties": {"tag": {"not": {"const": "latest"}}}},
      "then": {"properties": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}
    },
    "name": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "optionalName": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/name"}]},
    "namePrefix": {"type": "string", "maxLength": 43, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "secretName": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "optionalSecretName": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/secretName"}]},
    "storageClass": {"type": "string"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "quantity": {"type": "string", "minLength": 1}
  },
  "properties": {
    "nameOverride": {"$ref": "#/$defs/namePrefix"},
    "namespaceOverride": {"$ref": "#/$defs/optionalName"},
    "workersNamespaceOverride": {"$ref": "#/$defs/optionalName"},
    "serviceImage": {"$ref": "#/$defs/image"},
    "workerImage": {"$ref": "#/$defs/image"},
    "postgres": {
      "type": "object", "additionalProperties": false,
      "required": ["bundled", "image", "databaseSecretName", "user", "database", "storageClass", "size"],
      "properties": {
        "bundled": {"type": "boolean"}, "image": {"type": "string", "minLength": 1},
        "databaseSecretName": {"$ref": "#/$defs/secretName"},
        "user": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"}, "database": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
        "storageClass": {"$ref": "#/$defs/storageClass"}, "size": {"$ref": "#/$defs/quantity"}
      }
    },
    "ingress": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "className", "host", "tlsSecretName"],
      "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "host": {"type": "string", "minLength": 1}, "tlsSecretName": {"type": "string"}}
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["storageClass", "artifactsStorageClass", "artifactsSize", "referenceCacheStorageClass", "referenceCacheSize", "buildkitCacheStorageClass", "buildkitCacheSize"],
      "properties": {
        "storageClass": {"$ref": "#/$defs/storageClass"},
        "artifactsStorageClass": {"$ref": "#/$defs/storageClass"}, "artifactsSize": {"$ref": "#/$defs/quantity"},
        "referenceCacheStorageClass": {"$ref": "#/$defs/storageClass"}, "referenceCacheSize": {"$ref": "#/$defs/quantity"},
        "buildkitCacheStorageClass": {"$ref": "#/$defs/storageClass"}, "buildkitCacheSize": {"$ref": "#/$defs/quantity"}
      }
    },
    "buildkit": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "cluster": {
      "type": "object", "additionalProperties": false,
      "required": ["dnsIp", "dnsNamespace", "dnsPodLabels", "renderTimezone", "localEndpoint", "podPidLimitOverride", "imagePullSecret"],
      "properties": {
        "dnsIp": {"type": "string", "pattern": "^[0-9a-fA-F.:]+$"},
        "dnsNamespace": {"$ref": "#/$defs/name"},
        "dnsPodLabels": {"$ref": "#/$defs/labels"},
        "renderTimezone": {"type": "string", "minLength": 1},
        "localEndpoint": {
          "type": "object", "additionalProperties": false,
          "required": ["namespace", "podLabels", "port", "cidrs"],
          "properties": {
            "namespace": {"$ref": "#/$defs/optionalName"},
            "podLabels": {"$ref": "#/$defs/labels"},
            "port": {"type": "integer", "minimum": 0, "maximum": 65535},
            "cidrs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"}, "uniqueItems": true}
          }
        },
        "podPidLimitOverride": {"type": "integer", "minimum": 0},
        "imagePullSecret": {"$ref": "#/$defs/optionalSecretName"}
      }
    },
    "egress": {"type": "object", "additionalProperties": false, "required": ["allowlist"], "properties": {"allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "workerQuota": {
      "type": "object", "additionalProperties": false,
      "required": ["jobs", "persistentVolumeClaims", "requestsCpu", "requestsMemory", "limitsCpu", "limitsMemory"],
      "properties": {"jobs": {"$ref": "#/$defs/quantity"}, "persistentVolumeClaims": {"$ref": "#/$defs/quantity"}, "requestsCpu": {"$ref": "#/$defs/quantity"}, "requestsMemory": {"$ref": "#/$defs/quantity"}, "limitsCpu": {"$ref": "#/$defs/quantity"}, "limitsMemory": {"$ref": "#/$defs/quantity"}}
    },
    "secrets": {
      "type": "object", "additionalProperties": false,
      "required": ["githubApp", "githubAppPrivateKey", "githubAppWebhook", "firstRunToken"],
      "properties": {"githubApp": {"$ref": "#/$defs/secretName"}, "githubAppPrivateKey": {"$ref": "#/$defs/optionalSecretName"}, "githubAppWebhook": {"$ref": "#/$defs/optionalSecretName"}, "firstRunToken": {"$ref": "#/$defs/secretName"}}
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceStorageClass", "workspaceSize", "maxConcurrency", "launchTimeoutSeconds", "prepareTimeoutSeconds", "collectorTimeoutSeconds", "verifierTimeoutSeconds"],
      "properties": {"workspaceStorageClass": {"$ref": "#/$defs/storageClass"}, "workspaceSize": {"$ref": "#/$defs/quantity"}, "maxConcurrency": {"type": "integer", "minimum": 1}, "launchTimeoutSeconds": {"type": "integer", "minimum": 1}, "prepareTimeoutSeconds": {"type": "integer", "minimum": 1}, "collectorTimeoutSeconds": {"type": "integer", "minimum": 1}, "verifierTimeoutSeconds": {"type": "integer", "minimum": 1}}
    },
    "roomRunner": {
      "type": "object", "additionalProperties": false,
      "required": ["apiUrl", "provider", "image", "idleTimeoutMinutes", "maxRunnerSeconds", "defaultHarness", "defaultModel", "models"],
      "properties": {"apiUrl": {"type": "string"}, "provider": {"enum": ["kubernetes", "docker"]}, "image": {"type": "string"}, "idleTimeoutMinutes": {"type": "integer", "minimum": 1}, "maxRunnerSeconds": {"type": "integer", "minimum": 600}, "defaultHarness": {"type": "string", "minLength": 1}, "defaultModel": {"type": "string", "minLength": 1}, "models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "extraSettings": {
      "type": "object",
      "propertyNames": {"pattern": "^CRUCIBLE_[A-Z0-9_]+$"},
      "additionalProperties": {"type": "string"}
    }
  }
}
